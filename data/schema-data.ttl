@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix wgs: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix grshape: <https://w3id.org/FAIR-course-UT/2026/group07/shapes/> .
@prefix : <https://w3id.org/FAIR-course-UT/2026/group07/shapes/> .
@prefix dash: <http://datashapes.org/dash#> .

grshape:GeneralGroup
  a sh:PropertyGroup ;
  rdfs:label "General" ;
  sh:order 0 .

grshape:RiverShape
  a sh:NodeShape ;
  rdfs:label "River" ;
  sh:targetClass schema:RiverBodyOfWater ;
  sh:property _:b4_b8_b5_n3-0 ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "River name" ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path dct:identifier ;
    sh:name "River identifier" ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 3 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path dbo:country ;
    sh:name "Main country" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 4 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path schema:geoIntersects ;
    sh:name "Countries passed" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 5 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path schema:containedInPlace ;
    sh:name "Continent" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 6 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path schema:additionalProperty ;
    sh:name "Length" ;
    sh:nodeKind sh:IRI ;
    sh:class schema:PropertyValue ;
    sh:node grshape:LengthShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 7 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path dct:type ;
    sh:name "Length category" ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:node grshape:LengthCategoryShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( <https://w3id.org/FAIR-course-UT/2026/group07/length-category/short> <https://w3id.org/FAIR-course-UT/2026/group07/length-category/medium> <https://w3id.org/FAIR-course-UT/2026/group07/length-category/long> ) ;
    sh:order 8 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path dbo:sourcePosition ;
    sh:name "Source coordinates" ;
    sh:nodeKind sh:IRI ;
    sh:class schema:GeoCoordinates ;
    sh:node grshape:CoordinatesShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 9 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path dbo:mouthPosition ;
    sh:name "Mouth coordinates" ;
    sh:nodeKind sh:IRI ;
    sh:class schema:GeoCoordinates ;
    sh:node grshape:CoordinatesShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 10 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identity" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:order 11 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:name "Dataset provenance" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 12 ;
    dash:editor dash:TextFieldEditor ;
    sh:group grshape:GeneralGroup
  ] .

_:b4_b8_b5_n3-0
  sh:path rdf:type ;
  sh:name "Geographic feature type" ;
  sh:order 1 ;
  dash:editor dash:TextFieldEditor ;
  sh:group grshape:GeneralGroup .

grshape:CoordinatesShape
  a sh:NodeShape ;
  sh:targetClass schema:GeoCoordinates ;
  sh:property _:b4_b8_b5_n3-15 ;
  sh:property [
    sh:path schema:latitude ;
    sh:name "Latitude" ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property [
    sh:path schema:longitude ;
    sh:name "Longitude" ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 3 ;
    dash:editor dash:TextFieldEditor
  ] .

_:b4_b8_b5_n3-15
  sh:path rdf:type ;
  sh:name "Spatial thing type" ;
  sh:order 1 ;
  dash:editor dash:TextFieldEditor .

grshape:LengthShape
  a sh:NodeShape ;
  sh:targetClass schema:PropertyValue ;
  sh:property [
    sh:path schema:value ;
    sh:name "Length value" ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property _:b4_b8_b5_n3-19 ;
  sh:property _:b4_b8_b5_n3-20 .

_:b4_b8_b5_n3-19
  sh:path schema:unitCode ;
  sh:name "Unit: kilometres" ;

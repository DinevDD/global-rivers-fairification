  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:order 3 ;
  dash:editor dash:TextFieldEditor .

grshape:LengthCategoryShape
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:name "Category name" ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property [
    sh:path skos:definition ;
    sh:name "Category definition" ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor
  ] .

grshape:ExternalIdentityLinkShape
  a sh:NodeShape ;
  sh:targetClass rdf:Statement ;
  sh:property _:b4_b8_b5_n3-23 ;
  sh:property [
    sh:path rdf:subject ;
    sh:name "Linked river" ;
    sh:nodeKind sh:IRI ;
    sh:class schema:RiverBodyOfWater ;
    sh:node grshape:RiverShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property _:b4_b8_b5_n3-25 ;
  sh:property [
    sh:path rdf:object ;
    sh:name "External resource" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 4 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property [
    sh:path dct:source ;
    sh:name "Link provider" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 5 ;
    dash:editor dash:TextFieldEditor
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:name "External record provenance" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 6 ;
    dash:editor dash:TextFieldEditor
  ] .

_:b4_b8_b5_n3-23
  sh:path rdf:type ;
  sh:name "Provenance entity type" ;
  sh:order 1 ;
  dash:editor dash:TextFieldEditor .

_:b4_b8_b5_n3-25
  sh:path rdf:predicate ;

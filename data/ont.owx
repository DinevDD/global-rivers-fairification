    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LengthCategory</IRI>
        <Literal xml:lang="en">Three explicit SKOS concept individuals already present in the dataset, with length thresholds represented by skos:definition</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LengthCategory</IRI>
        <Literal xml:lang="en">River length category</Literal>
    </AnnotationAssertion>

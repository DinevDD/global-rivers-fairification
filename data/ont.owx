    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ExternalIdentityLink</IRI>
        <Literal xml:lang="en">Published RDF types each link as rdf:Statement and prov:Entity; rdf:subject points to the river, rdf:predicate is owl:sameAs, rdf:object is the external river URI, dct:source is the provider, and prov:wasDerivedFrom is the external source record. Reserved rdf:Statement and rdf:subject/rdf:predicate/rdf:object cannot be re-declared as OWL 2 DL classes/object properties; the reification structure remains fully specified in the companion SHACL file and diagram.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ExternalIdentityLink</IRI>

    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">An OWL 2 DL-oriented application model of the 1,387 river resources in the published FAIRified Turtle dataset. It reuses existing vocabulary IRIs, defines project-scoped role classes, and links them by OWL class restrictions. RDF reification uses rdf:Statement/rdf:subject/rdf:predicate/rdf:object in the underlying RDF and SHACL; these reserved RDF terms are not redeclared as OWL classes or object properties. Cardinalities are specified by the companion SHACL shapes.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="en">Global Rivers — verified semantic data model</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>1.1 — audited against the supplied RDF and SHACL</Literal>
    </Annotation>

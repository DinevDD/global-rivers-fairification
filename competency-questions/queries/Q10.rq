PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

SELECT ?river ?name ?countryCount ?lengthKm
WHERE {
  {
    SELECT ?river (COUNT(DISTINCT ?country) AS ?countryCount)
    WHERE {
      ?river a schema:RiverBodyOfWater ;
             schema:geoIntersects ?country .
    }
    GROUP BY ?river
    HAVING (COUNT(DISTINCT ?country) > 1)
  }
  ?river rdfs:label ?name ;
         schema:additionalProperty ?lengthNode .
  ?lengthNode schema:value ?lengthKm .
}
ORDER BY ?lengthKm
LIMIT 1

PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

SELECT ?name ?river1 ?river2
       (IF(COUNT(DISTINCT ?sharedCountry) > 0, "Yes", "No") AS ?sharesCountry)
       (COUNT(DISTINCT ?sharedCountry) AS ?sharedCountryCount)
WHERE {
  ?river1 a schema:RiverBodyOfWater ; rdfs:label ?name .
  ?river2 a schema:RiverBodyOfWater ; rdfs:label ?name .
  FILTER(STR(?river1) < STR(?river2))
  OPTIONAL {
    ?river1 schema:geoIntersects ?sharedCountry .
    ?river2 schema:geoIntersects ?sharedCountry .
  }
}
GROUP BY ?name ?river1 ?river2
ORDER BY ?name ?river1 ?river2

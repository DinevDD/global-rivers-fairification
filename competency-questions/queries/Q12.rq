PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

# DIAGNOSTIC ONLY: count rivers explicitly assigned >1 continent in *this RDF*.
# The dataset assigns one continent per river; result of 0 does NOT mean
# there are no transcontinental rivers. Q12 cannot be answered reliably.
SELECT (COUNT(?river) AS ?riversWithMultipleRecordedContinents)
WHERE {
  {
    SELECT ?river
    WHERE {
      ?river a schema:RiverBodyOfWater ;
             schema:containedInPlace ?continent .
    }
    GROUP BY ?river
    HAVING (COUNT(DISTINCT ?continent) > 1)
  }
}

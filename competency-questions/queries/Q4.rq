PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

SELECT ?continent (COUNT(DISTINCT ?river) AS ?longRiverCount)
WHERE {
  ?river a schema:RiverBodyOfWater ;
         schema:containedInPlace ?continent ;
         dct:type <https://w3id.org/FAIR-course-UT/2026/group07/length-category/long> .
}
GROUP BY ?continent
ORDER BY DESC(?longRiverCount)

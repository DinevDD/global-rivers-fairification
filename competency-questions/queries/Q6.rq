PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

SELECT ?country (ROUND(AVG(?lengthKm) * 100) / 100 AS ?averageKm)
       (COUNT(DISTINCT ?river) AS ?riverCount)
WHERE {
  ?river a schema:RiverBodyOfWater ;
         schema:geoIntersects ?country ;
         schema:additionalProperty ?lengthNode .
  ?lengthNode schema:value ?lengthKm .
}
GROUP BY ?country
ORDER BY DESC(?averageKm)

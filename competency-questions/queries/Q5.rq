PREFIX schema: <http://schema.org/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gr: <https://w3id.org/FAIR-course-UT/2026/group07/>

SELECT ?name (COUNT(DISTINCT ?river) AS ?riverCount)
WHERE {
  ?river a schema:RiverBodyOfWater ;
         rdfs:label ?name .
}
GROUP BY ?name
HAVING (COUNT(DISTINCT ?river) > 1)
ORDER BY DESC(?riverCount) ?name

<https://w3id.org/FAIR-course-UT/2026/group07/dataset/rivers> a dcat:Dataset ;
    dct:title "FAIRified Global Rivers" ;
    dct:description "A FAIRified dataset consisting of 1,387 unique river entries. Each is associated with a name, length, length category, spatial coordinates, a list of passed countries, main country, and a continent. The original dataset was transformed into RDF using established semantic vocabularies. River and geographical entities are linked to external resources, e.g., Wikidata and GeoNames. This is done to improve interoperability and reuse of the dataset. Provenance information and derived classification of the rivers based on their lengths are also included." ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group07/dataset/rivers" ;
    dcat:keyword "River", "GIS", "Geography", "Natural Earth", "Hydrology", "Linked Data", "Wikidata", "GeoNames" ;
    dct:spatial <http://www.wikidata.org/entity/Q2> ;
    dcat:version "1.0.0" ;
    dcat:theme <http://www.wikidata.org/entity/Q4022> ;
    dcat:landingPage <https://github.com/DinevDD/global-rivers-fairification> ;
    dct:creator <https://github.com/DinevDD> ;
    dct:publisher <https://www.utwente.nl/en/> ;
    dct:source <https://www.kaggle.com/datasets/sangampaudel530/global-rivers-dataset-lengths-and-countries> ;
    dct:issued "2026-10-11T00:00:00"^^xsd:dateTime ;
    dct:modified "2026-10-11T00:00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.kaggle.com/datasets/sangampaudel530/global-rivers-dataset-lengths-and-countries>, <https://www.naturalearthdata.com/> ;
    adms:versionNotes "Initial FAIRified release of the Global Rivers dataset. Modification include data cleaning, data enrichment (unique river identifiers), linking to external entities (Wikidata and GeoNames). Additional semantic representations were introduced for geographical coordinates, river lengths, river length categories, and provenance." ;
    dct:accessRights "public" ;
    dct:license <https://www.mit.edu/~amini/LICENSE.md> ;
    dcat:distribution <https://w3id.org/FAIR-course-UT/2026/group07/distribution/rivers-ttl> ;
    dcat:contactPoint <mailto:d.dinev-1@student.utwente.nl> ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2026/group07/shapes/river-shapes> ;
    foaf:page <https://github.com/DinevDD/global-rivers-fairification/blob/main/README.md>, <https://github.com/DinevDD/global-rivers-fairification/blob/main/documents/methodology.md>, <https://github.com/DinevDD/global-rivers-fairification/blob/main/documents/data-dictionary.md> ;
    dct:references <https://www.kaggle.com/datasets/sangampaudel530/global-rivers-dataset-lengths-and-countries>, <https://www.naturalearthdata.com/> ;
    void:vocabulary <http://schema.org/>, <http://www.opengis.net/ont/geosparql#>, dct:, <http://dbpedia.org/ontology/>, skos:, prov:, <http://www.w3.org/2003/01/geo/wgs84_pos#>, <http://www.w3.org/2002/07/owl#>, <http://qudt.org/vocab/unit/> ;
    void:uriSpace "https://w3id.org/FAIR-course-UT/2026/group07/" ;
    void:exampleResource <https://w3id.org/FAIR-course-UT/2026/group07/river/river-14deb23c806d097f> ;
    void:triples "43499"^^xsd:nonNegativeInteger ;
    void:classPartition [
        void:class <http://schema.org/RiverBodyOfWater> ;
        void:entities "1387"^^xsd:nonNegativeInteger
    ], [
        void:class <http://www.opengis.net/ont/geosparql#Feature> ;
        void:entities "1387"^^xsd:nonNegativeInteger
    ], [
        void:class <http://schema.org/GeoCoordinates> ;
        void:entities "2774"^^xsd:nonNegativeInteger
    ], [
        void:class <http://schema.org/PropertyValue> ;
        void:entities "1387"^^xsd:nonNegativeInteger
    ], [
        void:class skos:Concept ;
        void:entities "3"^^xsd:nonNegativeInteger
    ] .

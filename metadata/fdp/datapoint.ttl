  <http://www.w3.org/2000/01/rdf-schema#label> "Global Rivers FAIR Data Point";
  dcterms:title "Global Rivers FAIR Data Point";
  dcat:version "1.0";
  <https://w3id.org/fdp/fdp-o#metadataIssued> "2026-10-11T21:58:01.739226855Z"^^xsd:dateTime;
